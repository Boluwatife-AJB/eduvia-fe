# Define colors for better readability
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Print header
echo -e "\n${BLUE}🔍 PRE-COMMIT CHECKS${NC}"
echo -e "${BLUE}===================${NC}\n"

# Function for error handling
handle_error() {
  echo -e "\n${RED}❌ $1 failed!${NC}"
  echo -e "${YELLOW}Please fix the issues before committing.${NC}\n"
  exit 1
}

npx lint-staged


# TypeScript type checking
echo -e "${BLUE}🔎 Verifying TypeScript types...${NC}"
npm run type-check || handle_error "TypeScript type check"
echo -e "${GREEN}✓ Type checking passed!${NC}\n"

# Success message
echo -e "${GREEN}✅ All checks passed successfully!${NC}"
echo -e "${GREEN}🚀 Proceeding with commit...${NC}\n"

exit 0
